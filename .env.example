# Copie para .env e preencha. O .env é gitignored — NUNCA comitar credenciais.
#
# Credenciais AWS para ler a camada Gold da pipeline da Fase 2.
# Necessárias apenas no 1º download; depois o cache local (data/gold/*.parquet)
# é usado offline. O bucket é fixo no código (src/preprocessing/gold_consumer.py).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# Versão da pipeline da Fase 2 que gerou a Gold consumida (informativo).
PIPELINE_VERSION=
